{
  "name": "marketing-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for the landcraft React component library (token-based theming, contrast guarantees) and its Storybook playground.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @ugurdemirel/landcraft build",
    "storybook": "pnpm --filter @ugurdemirel/landcraft-storybook storybook",
    "build:storybook": "pnpm --filter @ugurdemirel/landcraft-storybook build:storybook",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  }
}
